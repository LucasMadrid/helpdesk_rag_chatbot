POSTGRES_PASSWORD=change-me
CLICKHOUSE_PASSWORD=change-me
REDIS_AUTH=change-me
MINIO_ROOT_PASSWORD=change-me
LANGFUSE_S3_EVENT_UPLOAD_SECRET_ACCESS_KEY=change-me   # same as MINIO_ROOT_PASSWORD
LANGFUSE_S3_MEDIA_UPLOAD_SECRET_ACCESS_KEY=change-me
LANGFUSE_S3_BATCH_EXPORT_SECRET_ACCESS_KEY=change-me
DATABASE_URL=postgresql://postgres:change-me@postgres:5432/postgres
SALT=change-me
ENCRYPTION_KEY=change-me   # 64 hex chars
NEXTAUTH_SECRET=change-me

# App database (app-db service)
APP_DB_USER=helpdesk
APP_DB_PASSWORD=change-me
APP_DB_NAME=helpdesk
APP_DB_URL=postgresql://helpdesk:change-me@127.0.0.1:5433/helpdesk
APP_ENV=development

# TEST ENV
TEST_APP_DB_URL=postgresql://helpdesk:change-me@127.0.0.1:5433/helpdesk

# LangFuse
LANGFUSE_SECRET_KEY=change-me
LANGFUSE_PUBLIC_KEY=change-me
LANGFUSE_BASE_URL="http://localhost:3000"
# Send traces to Langfuse (default: false; tests and CI leave it off)
LANGFUSE_ENABLED=true

# LiteLLM
LITELLM_URL=http://localhost:4000
LITELLM_KEY=sk-litellm
LITELLM_MODEL=gpt-test

# LLM timeout in seconds (default: 15.0)
LLM_TIMEOUT=15.0

# Token budget for earlier turns sent to the model (approximate count, default 2000)
HISTORY_MAX_TOKENS=2000

# Split configuration
SPLITTER="recursive"
CHUNK_SIZE=800
CHUNK_OVERLAP=100

# Pinecone
PINECONE_API_KEY="change-me"
PINECONE_INDEX="helpdesk-corpus"
EMBEDDING_MODEL="text-embedding-3-small"
EMBEDDING_DIMENSIONS=1536

# Logging level (default: INFO). One of DEBUG, INFO, WARNING, ERROR, CRITICAL.
# Must be uppercase: "info" is rejected when the settings load.
LOG_LEVEL=INFO
